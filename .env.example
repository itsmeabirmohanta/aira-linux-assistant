# ============================================================
# ARIA — Autonomous Resident Intelligence Agent
# Copy this file to .env and fill in your values
# ============================================================

# --- AI Provider ---
# Options: gemini | openai | claude | ollama
ARIA_PROVIDER=gemini

# --- API Keys (only the one you use needs to be set) ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama local server URL (no key needed)
OLLAMA_BASE_URL=http://localhost:11434
# Use a vision-capable model like llava
OLLAMA_MODEL=llava

# --- Agent Behavior ---
ARIA_HOTKEY=ctrl+space
ARIA_CONFIRM_DESTRUCTIVE=true
# Max tool calls per task
ARIA_MAX_STEPS=20
ARIA_STREAM_RESPONSES=true

# --- Voice ---
# Options: tiny.en | base.en | small.en | medium.en (larger = more accurate, slower)
ARIA_VOICE_MODEL=base.en
ARIA_VOICE_LANGUAGE=en

# --- Memory ---
ARIA_MEMORY_DIR=~/.aria
ARIA_MEMORY_MAX_SESSIONS=100
# Recent messages to keep in short-term context
ARIA_CONTEXT_WINDOW=10

# --- Wayland / Display ---
# For Wayland: ydotool for input, grim for screenshots
# For X11:     pyautogui for input, pyscreenshot for screenshots
# Options: wayland | x11 (auto-detected if not set)
ARIA_DISPLAY_SERVER=wayland

# --- UI ---
ARIA_OVERLAY_WIDTH=680
ARIA_OVERLAY_OPACITY=0.95
# Options: dark | light
ARIA_THEME=dark

# --- Logging ---
# Options: DEBUG | INFO | WARNING | ERROR
ARIA_LOG_LEVEL=INFO
